<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#11111B"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="✦  AI VIDEO STUDIO"
            android:textColor="#C4B5FD"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Your story.&#10;The big screen."
            android:textColor="#F8FAFC"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/connectionStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Đang kết nối dịch vụ…"
            android:textColor="#A1A1AA"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="#1D1D2B"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tài khoản"
                android:textColor="#F8FAFC"
                android:textSize="19sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/signInTab"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Đăng nhập" />
                <Button
                    android:id="@+id/signUpTab"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Đăng ký" />
            </LinearLayout>

            <EditText
                android:id="@+id/emailInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Email"
                android:inputType="textEmailAddress"
                android:textColor="#F8FAFC"
                android:textColorHint="#8B8B98" />
            <EditText
                android:id="@+id/passwordInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Mật khẩu"
                android:inputType="textPassword"
                android:textColor="#F8FAFC"
                android:textColorHint="#8B8B98" />
            <Button
                android:id="@+id/emailAuthButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tiếp tục với email" />
            <Button
                android:id="@+id/googleButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="G  Tiếp tục với Google" />
            <Button
                android:id="@+id/facebookButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="f  Tiếp tục với Facebook" />
            <Button
                android:id="@+id/appleButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="  Tiếp tục với Apple" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Đăng nhập xã hội cần cấu hình OAuth client của ứng dụng."
                android:textColor="#A1A1AA"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="#1D1D2B"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="01  ·  Tạo phim từ câu chuyện"
                android:textColor="#F8FAFC"
                android:textSize="19sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Dán kịch bản hoặc ý tưởng. AI sẽ chia cảnh và tạo lời dẫn."
                android:textColor="#A1A1AA"
                android:textSize="13sp" />
            <EditText
                android:id="@+id/storyInput"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="12dp"
                android:gravity="top|start"
                android:hint="Hãy kể câu chuyện bạn muốn biến thành phim…"
                android:inputType="textMultiLine|textCapSentences"
                android:padding="14dp"
                android:textColor="#F8FAFC"
                android:textColorHint="#8B8B98" />
            <Button
                android:id="@+id/suggestionsToggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⌄  Gợi ý thể loại, phong cách &amp; tâm trạng" />
            <LinearLayout
                android:id="@+id/suggestionsPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Thể loại  ·  Hành động / Kinh dị / Lãng mạn"
                    android:textColor="#DDD6FE" />
                <Spinner
                    android:id="@+id/categorySpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Phong cách  ·  Điện ảnh / Anime / 3D"
                    android:textColor="#DDD6FE" />
                <Spinner
                    android:id="@+id/styleSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tâm trạng  ·  Kịch tính / U tối / Ấm áp"
                    android:textColor="#DDD6FE" />
                <Spinner
                    android:id="@+id/moodSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
            <TextView
                android:id="@+id/durationLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Thời lượng: 60 giây"
                android:textColor="#E4E4E7" />
            <SeekBar
                android:id="@+id/durationSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="1770"
                android:progress="30" />
            <CheckBox
                android:id="@+id/generateImagesCheck"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tạo ảnh cảnh bằng Pollinations AI (có thể áp dụng giới hạn dịch vụ)"
                android:textColor="#DDD6FE" />
            <Button
                android:id="@+id/generateButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✦  Tạo phân cảnh bằng AI" />
            <TextView
                android:id="@+id/generationResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#D4D4D8"
                android:textSize="14sp" />
            <LinearLayout
                android:id="@+id/generationImages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="#1D1D2B"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="02  ·  Lồng tiếng &amp; dịch video"
                android:textColor="#F8FAFC"
                android:textSize="19sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/selectedVideoLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Chưa chọn video"
                android:textColor="#A1A1AA" />
            <Button
                android:id="@+id/pickVideoButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chọn video từ thiết bị" />
            <Spinner
                android:id="@+id/languageSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bản lồng tiếng dùng giọng TTS; không sao chép giọng người thật."
                android:textColor="#A1A1AA"
                android:textSize="12sp" />
            <Button
                android:id="@+id/translateButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Dịch &amp; tạo bản lồng tiếng" />
            <TextView
                android:id="@+id/translationResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#D4D4D8" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="24dp"
            android:background="#1D1D2B"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="03  ·  Bàn dựng phim"
                android:textColor="#F8FAFC"
                android:textSize="19sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/audioVisualizer"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:gravity="center"
                android:text="▂ ▄ ▆ ▃ ▇ ▄ ▂ ▅ ▇ ▃ ▆ ▂ ▄ ▇ ▅ ▃"
                android:textColor="#A78BFA"
                android:textSize="20sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tỷ lệ khung hình"
                android:textColor="#DDD6FE" />
            <Spinner
                android:id="@+id/aspectSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cỡ chữ phụ đề"
                android:textColor="#DDD6FE" />
            <TextView
                android:id="@+id/subtitlePreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="12dp"
                android:text="Bản xem trước phụ đề"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />
            <SeekBar
                android:id="@+id/subtitleSizeSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="48"
                android:progress="18" />
            <TextView
                android:id="@+id/subtitleSizeLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cỡ chữ: 18sp · Bóng: bật"
                android:textColor="#D4D4D8" />
            <Button
                android:id="@+id/subtitleShadowButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tắt bóng phụ đề" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TIMELINE   00:00 ━━━━━━━●━━━━━━━━ 00:30"
                android:textColor="#C4B5FD" />
            <SeekBar
                android:id="@+id/timelineSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="300"
                android:progress="80" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
