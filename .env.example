# Public mobile configuration. These are publishable values, never service-role keys.
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# API/server only. Never place these in Expo EXPO_PUBLIC_* variables.
NODE_ENV=development
API_PORT=4000
API_HOST=0.0.0.0
API_RATE_LIMIT=120
CORS_ORIGIN=http://localhost:8081
ADMIN_EMAILS=
DATABASE_URL=
REDIS_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_OAUTH_REDIRECT_URL=cineforge://auth/callback
SUPABASE_STORAGE_BUCKET=cineforge-assets

# Text/image/video/voice providers. Demo adapters activate per provider when unset.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TRANSCRIPTION_MODEL=
FAL_API_KEY=
FAL_IMAGE_MODEL=
RUNWAYML_API_SECRET=
RUNWAY_MODEL=
REPLICATE_API_TOKEN=
REPLICATE_VIDEO_MODEL=
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=
ELEVENLABS_DEFAULT_VOICE_ID=
ELEVENLABS_VOICES=[]

# Video worker and rendering.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FFMPEG_4K_SUPPORTED=false
WORKER_CONCURRENCY=2
WORKER_RATE_LIMIT=20
OUTPUT_DIR=./exports

# OAuth provider app credentials. API secrets belong in server deployment secrets.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
APPLE_SERVICE_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
META_APP_ID=
META_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Official publishing permissions are granted per platform, not inferred from OAuth.
YOUTUBE_PUBLISHING_APPROVED=false
TIKTOK_PUBLISHING_APPROVED=false
FACEBOOK_PUBLISHING_APPROVED=false
INSTAGRAM_PUBLISHING_APPROVED=false

# Billing adapter. Checkout remains unavailable until all values are configured.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=

# Configurable plan limits and credit costs.
PLAN_FREE_PROJECTS=3
PLAN_FREE_IMAGES_MONTHLY=10
PLAN_FREE_VIDEOS_MONTHLY=3
PLAN_FREE_TTS_MINUTES_MONTHLY=30
PLAN_FREE_CREDITS_MONTHLY=200
PLAN_FREE_MAX_RESOLUTION=720p
PLAN_PRO_PROJECTS=100
PLAN_PRO_IMAGES_MONTHLY=500
PLAN_PRO_VIDEOS_MONTHLY=100
PLAN_PRO_TTS_MINUTES_MONTHLY=600
PLAN_PRO_CREDITS_MONTHLY=10000
PLAN_PRO_MAX_RESOLUTION=1080p
CREDIT_COST_TEXT=2
CREDIT_COST_IMAGE=8
CREDIT_COST_VIDEO=30
CREDIT_COST_TTS=3
CREDIT_COST_TRANSLATION=2
CREDIT_COST_UPSCALE=12
CREDIT_COST_RENDER=5

# EAS build credentials are configured in Expo/EAS secrets, not this file.